# ======== ড্যাশবোর্ড (আবশ্যক) ========
# ড্যাশবোর্ডে ঢোকার পাসওয়ার্ড — কমপক্ষে ৮ অক্ষর, শক্ত দিন
ADMIN_PASSWORD=jannat1234
# (ঐচ্ছিক) কুকি সাইন করার গোপন কী; না দিলে ADMIN_PASSWORD ব্যবহৃত হয়
SESSION_SECRET=jannat1234

# ======== ডাটা সংরক্ষণ ========
# Railway-তে Volume মাউন্ট পাথ (README দেখুন)। লোকালে না দিলে ./data
DATA_DIR=/data
# সার্ভার চালুর সাথে সাথে বট অটো-স্টার্ট (false দিলে ড্যাশবোর্ড থেকে হাতে স্টার্ট দিতে হবে)
AUTO_START=true

# ======== বট সেটিংস ========
PREFIX=.
BOT_NAME=GroupGuard
# মালিকের নম্বর (কান্ট্রি কোড সহ, + ছাড়া; একাধিক হলে কমা)
OWNER_NUMBERS=8801715791479
# প্রাইভেট মোডের শুরুর মান: true হলে শুধু বটের নম্বর (ও উপরের OWNER_NUMBERS) বট চালাতে পারে
# পরে গ্রুপ/চ্যাট থেকে .private on|off দিয়ে বদলানো যায় (সেটিং সংরক্ষিত থাকে)
PRIVATE_MODE=false
# নতুন গ্রুপের ডিফল্ট ডিজাইন (পরে গ্রুপে .theme / .font / .lang দিয়ে বদলানো যায়)
# থিম: blossom | classic | royal | neon | galaxy | cyber | candy | minimal
DEFAULT_THEME=blossom
# ফন্ট: auto (থিমের নিজস্ব মিশ্রণ) | normal | bold | serifbold | italic | bolditalic | sansitalic | script | fraktur | boldfraktur | double | mono | smallcaps | wide | circle | square
DEFAULT_FONT=auto
# গ্রুপে দেখানো মেসেজের ভাষা: en | bn
DEFAULT_LANG=en
# ওয়েলকাম স্টাইল: card (সাইডে প্রোফাইল ছবি) | photo | text
WELCOME_STYLE=card
# ফ্লাড: FLOOD_SECONDS সেকেন্ডে FLOOD_MESSAGES টির বেশি মেসেজ = ফ্লাড
FLOOD_MESSAGES=7
FLOOD_SECONDS=8
# এতটি ওয়ার্নে অটো-কিক
WARN_LIMIT=3
# XP: একই সদস্য কত সেকেন্ড পরপর XP পাবে
XP_COOLDOWN=25
# নতুন সদস্য কত মিনিটের মধ্যে ভেরিফাই না করলে রিমুভ
VERIFY_MINUTES=5
# ওয়েলকাম-কার্ডে ট্যাপ করলে যে লিঙ্ক খুলবে
# খালি = কার্ডে কোনো লিংক নেই
CARD_LINK=

# ======== AI চ্যাট ও অনুবাদ (Google Gemini — ফ্রি টায়ার) ========
# চাবি পাবেন https://aistudio.google.com → "Get API key" থেকে (ফ্রি)। না দিলে .ai কাজ করে না;
# .translate তখন বিনামূল্যের MyMemory দিয়ে চলে।
GEMINI_API_KEY=AQ.Ab8RN6Lgh7CdpLnmpbR2z-Ls_UbkwSL11Qun_XLThmO7s0qLHA
# মডেল: gemini-3.1-flash-lite (ডিফল্ট, ফ্রি টায়ারে চলে)। বদলাতে চাইলে এখানে দিন, যেমন gemini-3.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite
# একই সদস্য কত সেকেন্ড পরপর .ai ব্যবহার করতে পারবে
AI_COOLDOWN=15
# প্রতি গ্রুপে দিনে সর্বোচ্চ কতবার AI/অনুবাদ (ফ্রি কোটা বাঁচাতে)
AI_DAILY_LIMIT=300

# ======== আরও ফিচার ========
# দেশের কোড-ফিল্টারের ডিফল্ট কোড (কমা দিয়ে, + ছাড়া)। গ্রুপে .countrylock দিয়ে বদলানো যায়
ALLOWED_COUNTRY_CODES=880
# স্লো-মোডের ডিফল্ট সেকেন্ড (.slowmode <সেকেন্ড> দিয়ে বদলানো যায়)
SLOW_SECONDS=10
# জন্মদিনের শুভেচ্ছা কোন ঘণ্টায় যাবে (০–২৩, TIMEZONE অনুযায়ী)
BIRTHDAY_HOUR=9
# 0 = আনলিমিটেড মেনশন
MENTION_LIMIT=0
LINK_WARN_LIMIT=0
LINK_WHITELIST=
ADMIN_LOG_NOTIFY=true
TIMEZONE=Asia/Dhaka
HELP_LINK=

# ======== মিউজিক API (ঐচ্ছিক) ========
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# PORT — Railway নিজেই দেয়, সেট করার দরকার নেই
