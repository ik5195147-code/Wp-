# ======== ড্যাশবোর্ড (আবশ্যক) ========
# ড্যাশবোর্ডে ঢোকার পাসওয়ার্ড — কমপক্ষে ৮ অক্ষর, শক্ত দিন
ADMIN_PASSWORD=
# (ঐচ্ছিক) কুকি সাইন করার গোপন কী; না দিলে ADMIN_PASSWORD ব্যবহৃত হয়
SESSION_SECRET=

# ======== ডাটা সংরক্ষণ ========
# Railway-তে Volume মাউন্ট পাথ (README দেখুন)। লোকালে না দিলে ./data
DATA_DIR=/data
# সার্ভার চালুর সাথে সাথে বট অটো-স্টার্ট (false দিলে ড্যাশবোর্ড থেকে হাতে স্টার্ট দিতে হবে)
AUTO_START=true

# ======== বট সেটিংস ========
PREFIX=.
BOT_NAME=GroupGuard
# মালিকের নম্বর (কান্ট্রি কোড সহ, + ছাড়া; একাধিক হলে কমা)
OWNER_NUMBERS=8801XXXXXXXXX
# নতুন গ্রুপের ডিফল্ট ডিজাইন (পরে গ্রুপে .theme / .font / .lang দিয়ে বদলানো যায়)
# থিম: blossom | classic | royal | neon | galaxy | cyber | candy | minimal
DEFAULT_THEME=blossom
# ফন্ট: auto (থিমের নিজস্ব মিশ্রণ) | normal | bold | serifbold | italic | bolditalic | sansitalic | script | fraktur | boldfraktur | double | mono | smallcaps | wide | circle | square
DEFAULT_FONT=auto
# গ্রুপে দেখানো মেসেজের ভাষা: en | bn
DEFAULT_LANG=en
# ওয়েলকাম স্টাইল: card (সাইডে প্রোফাইল ছবি) | photo | text
WELCOME_STYLE=card
# ফ্লাড: FLOOD_SECONDS সেকেন্ডে FLOOD_MESSAGES টির বেশি মেসেজ = ফ্লাড
FLOOD_MESSAGES=7
FLOOD_SECONDS=8
# এতটি ওয়ার্নে অটো-কিক
WARN_LIMIT=3
# XP: একই সদস্য কত সেকেন্ড পরপর XP পাবে
XP_COOLDOWN=25
# নতুন সদস্য কত মিনিটের মধ্যে ভেরিফাই না করলে রিমুভ
VERIFY_MINUTES=5
# ওয়েলকাম-কার্ডে ট্যাপ করলে যে লিঙ্ক খুলবে
CARD_LINK=https://www.whatsapp.com
MENTION_LIMIT=5
LINK_WARN_LIMIT=1
LINK_WHITELIST=
ADMIN_LOG_NOTIFY=true
TIMEZONE=Asia/Dhaka
HELP_LINK=

# ======== মিউজিক API (ঐচ্ছিক) ========
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# PORT — Railway নিজেই দেয়, সেট করার দরকার নেই
